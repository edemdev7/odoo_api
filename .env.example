# Configuration Odoo
ODOO_URL=https://holdingithiel-dagbehami-statging-012026-27069493.dev.odoo.com
ODOO_DB=holdingithiel-dagbehami-statging-012026-27069493
ODOO_USERNAME=votre-email@example.com
ODOO_PASSWORD=votre-mot-de-passe

# Configuration JWT
JWT_SECRET_KEY=votre-secret-key-super-securisee-a-changer
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8

# Configuration RSA (encryption webhooks)
RSA_PUBLIC_KEY_PATH=public.pem
RSA_PRIVATE_KEY_PATH=private.pem

# Configuration Webhook Fuel Monitor
FUEL_WEBHOOK_URL=https://api-jnp-dev.opensi.co/public/odoo/webhook
FUEL_WEBHOOK_TIMEOUT=10

# Secret partagé pour signer les webhooks sortants (header x-odoo-signature).
# Signature = HMAC-SHA256 hex du contenu du header x-encrypted-data.
# NE JAMAIS committer la vraie valeur : la renseigner dans le .env du serveur.
ODOO_WEBHOOK_SECRET=

# Lecture du secret pour construire la clé HMAC :
#   raw → la chaîne telle quelle (défaut)
#   hex → les octets décodés depuis l'hexadécimal
ODOO_WEBHOOK_SECRET_ENCODING=raw

# Secret partagé pour la réception des bons de livraison poussés par OPEN SI
# (POST /pos/inventory/transfers/{id}/delivery-note).
# La signature attendue est le HMAC-SHA256 hexadécimal du contenu binaire du PDF,
# transmise dans l'en-tête x-opensi-signature.
# Sans cette variable, l'endpoint refuse tout dépôt avec un 503.
OPENSI_BL_SECRET=

# Configuration Scheduler de surveillance automatique
# Intervalle en secondes entre chaque vérification (défaut: 60 secondes = 1 minute)
CREDIT_CHECK_INTERVAL=60

# Moyens de paiement dont la vente ne donne PAS lieu à facture automatique
# (comparaison sans casse : un mot de la liste doit figurer dans le libellé du
# pos.payment.method). Une recharge JNP PASS est une avance (419101) : sa
# consommation est le vrai chiffre d'affaires.
#
# Arbitrage du comptable JNP, novembre 2026 : « la consommation par JNP Pass
# donne droit à un bordereau de livraison au profit du client. Une facture
# n'est pas éditée. » D'où la présence de JNP PASS dans la liste — la vente
# est bien comptabilisée, par l'écriture de clôture du journal POS, et le
# bordereau est le transfert de stock créé à l'encaissement.
POS_PAYMENT_METHODS_SANS_FACTURE=TOKEN,CARTE,CARD,JNP PASS

# Politique de facturation automatique des ventes comptoir :
#   client_nomme (défaut) — facture si un vrai client est rattaché à la vente
#   toujours              — facture toute vente, hors moyens exclus ci-dessus
#   jamais                — aucune facture automatique
POS_AUTO_INVOICE=client_nomme

# Autorise une vente réglée à la fois par un moyen prépayé et par un autre
# moyen. Refusé par défaut : les deux parts suivent des écritures comptables
# différentes (419101 pour l'avance, créance client pour le reste) et le
# comptable demande une facturation par mode de paiement.
POS_ALLOW_MIXED_PREPAID=

# Condition de paiement posée sur les rechargements TVPASS. Vide, l'API
# résout « Immediate Payment » par son identifiant externe Odoo.
ACCOUNTING_PAYMENT_TERM_ID=

# Client générique porté sur les factures de ventes anonymes (vente à la pompe).
# Odoo exige un partenaire sur toute facture. Laissé vide, l'API cherche un
# contact nommé « Client comptant », « Client divers », « Comptant » ou
# « Client anonyme ». Renseigner l'ID pour lever toute ambiguïté.
POS_DEFAULT_PARTNER_ID=
