# Configuration Odoo
ODOO_URL=https://holdingithiel-dagbehami-statging-012026-27069493.dev.odoo.com
ODOO_DB=holdingithiel-dagbehami-statging-012026-27069493
ODOO_USERNAME=votre-email@example.com
ODOO_PASSWORD=votre-mot-de-passe

# Configuration JWT
JWT_SECRET_KEY=votre-secret-key-super-securisee-a-changer
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=8

# Configuration RSA (encryption webhooks)
RSA_PUBLIC_KEY_PATH=public.pem
RSA_PRIVATE_KEY_PATH=private.pem

# Configuration Webhook Fuel Monitor
FUEL_WEBHOOK_URL=https://api-jnp-dev.opensi.co/public/odoo/webhook
FUEL_WEBHOOK_TIMEOUT=10

# Secret partagé pour signer les webhooks sortants (header x-odoo-signature).
# Signature = HMAC-SHA256 hex du contenu du header x-encrypted-data.
# NE JAMAIS committer la vraie valeur : la renseigner dans le .env du serveur.
ODOO_WEBHOOK_SECRET=

# Lecture du secret pour construire la clé HMAC :
#   raw → la chaîne telle quelle (défaut)
#   hex → les octets décodés depuis l'hexadécimal
ODOO_WEBHOOK_SECRET_ENCODING=raw

# Configuration Scheduler de surveillance automatique
# Intervalle en secondes entre chaque vérification (défaut: 60 secondes = 1 minute)
CREDIT_CHECK_INTERVAL=60
