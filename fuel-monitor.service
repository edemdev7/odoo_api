# Service systemd pour le moniteur de comptes fuel

[Unit]
Description=Fuel Monitor - Surveillance des comptes fuel Odoo
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/home/edem/Téléchargements/odoo_api
Environment="PATH=/home/edem/Téléchargements/odoo_api/venv/bin"
Environment="JWT_TOKEN=YOUR_JWT_TOKEN_HERE"
Environment="API_BASE_URL=http://localhost:8001"
Environment="CHECK_INTERVAL_SECONDS=120"
ExecStart=/home/edem/Téléchargements/odoo_api/venv/bin/python fuel_monitor_scheduler.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
